---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import { formatarData, notasPorIdioma, slugDaNota, type Nota } from "../../utils/notas";

export async function getStaticPaths() {
  const notas = await notasPorIdioma("pt");
  return notas.map((nota) => ({ params: { slug: slugDaNota(nota) }, props: { nota } }));
}

interface Props {
  nota: Nota;
}

const { nota } = Astro.props;
const { titulo, resumo, data, tags, linkedin } = nota.data;
const { Content } = await render(nota);
---

<Layout title={`${titulo} — Thayná Tolentino`} description={resumo}>
  <Header current="/#notas" />

  <main class="mx-auto max-w-3xl px-6 py-12 md:py-16 space-y-10">
    <a
      href="/notas"
      class="inline-flex items-center gap-2 text-sm text-text-muted hover:text-accent transition-colors"
    >
      <span aria-hidden="true">←</span>
      Todas as notas
    </a>

    <article class="space-y-10">
      <header class="space-y-5">
        <time datetime={data.toISOString()} class="text-sm text-text-muted font-mono">
          {formatarData(data, "pt")}
        </time>
        <h1 class="font-display text-5xl md:text-6xl text-text-strong leading-[1.05]">
          {titulo}
        </h1>
        {
          tags.length > 0 && (
            <ul class="flex flex-wrap gap-1.5">
              {tags.map((t) => (
                <li class="text-xs px-2.5 py-1 rounded-full bg-surface-alt text-text-muted">{t}</li>
              ))}
            </ul>
          )
        }
      </header>

      <div class="prosa">
        <Content />
      </div>

      {
        linkedin && (
          <footer class="border-t border-border pt-6 text-sm text-text-muted">
            Publicado originalmente no{" "}
            <a
              href={linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent hover:text-accent-hover underline underline-offset-2"
            >LinkedIn</a>.
          </footer>
        )
      }
    </article>
  </main>

  <Footer />
</Layout>
