---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import Badge from "../../components/ui/Badge.astro";
import { projetos } from "../../data/projetos";
import type { Projeto } from "../../types";

export function getStaticPaths() {
  return projetos.map((projeto) => ({
    params: { slug: projeto.slug },
    props: { projeto },
  }));
}

interface Props {
  projeto: Projeto;
}

const { projeto } = Astro.props;
const contato = "thayvfx@gmail.com";

// imagem/galeria podem ser string (URL externa) ou ImageMetadata (asset otimizado)
const src = (img: Projeto["imagem"]) => (typeof img === "string" ? img : img.src);
const imgSrc = src(projeto.imagem);
const galeria = (projeto.detalhes?.galeria ?? []).map(src);

// Só exibe o link do repositório quando ele é público.
const mostrarRepo = Boolean(projeto.github) && projeto.repoPrivado !== true;

const assuntoAcesso = encodeURIComponent(
  `Acesso ao código — ${projeto.titulo}`,
);
const corpoAcesso = encodeURIComponent(
  `Olá, Thayná! Vi o projeto "${projeto.titulo}" no seu portfólio e gostaria de conhecer o código.`,
);

const temDetalhes = Boolean(
  projeto.detalhes?.problema ||
    projeto.detalhes?.solucao ||
    projeto.detalhes?.aprendizados ||
    (projeto.detalhes?.funcionalidades?.length ?? 0) > 0,
);
---

<Layout
  title={`${projeto.titulo} — Thayná Tolentino`}
  description={projeto.descricao}
>
  <Header />

  <main class="mx-auto max-w-5xl px-6 py-12 md:py-16 space-y-12">
    <!-- Voltar -->
    <a
      href="/#projetos"
      class="inline-flex items-center gap-2 text-sm text-text-muted hover:text-accent transition-colors"
    >
      <span aria-hidden="true">←</span>
      Voltar aos projetos
    </a>

    <!-- Cabeçalho -->
    <header class="space-y-6">
      <Badge nicho={projeto.nicho} variant="soft" size="md" />

      <h1
        class="font-display text-5xl md:text-7xl text-text-strong leading-[0.95]"
      >
        {projeto.titulo}
      </h1>

      <p class="text-lg md:text-xl text-text-muted max-w-2xl leading-relaxed">
        {projeto.descricao}
      </p>

      <!-- Ações -->
      <div class="flex flex-wrap items-center gap-3 pt-2">
        {
          projeto.demo && (
            <a
              href={projeto.demo}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-md bg-accent text-accent-fg text-sm font-semibold hover:opacity-90 transition-opacity"
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="7" y1="17" x2="17" y2="7" />
                <polyline points="7 7 17 7 17 17" />
              </svg>
              Ver demo ao vivo
            </a>
          )
        }

        {
          projeto.link && (
            <a
              href={projeto.link}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-md border border-border-strong text-sm font-medium text-text hover:border-accent hover:text-accent transition-colors"
            >
              Ver projeto
              <span aria-hidden="true">→</span>
            </a>
          )
        }

        {
          mostrarRepo && (
            <a
              href={projeto.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-md border border-border-strong text-sm font-medium text-text hover:border-accent hover:text-accent transition-colors"
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path d="M12 .5C5.73.5.5 5.73.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.3-1.7-1.3-1.7-1.06-.72.08-.71.08-.71 1.17.08 1.79 1.2 1.79 1.2 1.04 1.79 2.73 1.27 3.4.97.1-.75.4-1.27.73-1.56-2.56-.29-5.26-1.28-5.26-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.28 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5z" />
              </svg>
              Ver código
            </a>
          )
        }

        {
          projeto.repoPrivado && (
            <a
              href={`mailto:${contato}?subject=${assuntoAcesso}&body=${corpoAcesso}`}
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-md border border-border-strong text-sm font-medium text-text-muted hover:border-accent hover:text-accent transition-colors"
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
              </svg>
              Código privado — solicitar acesso
            </a>
          )
        }
      </div>
    </header>

    <!-- Imagem principal -->
    <div
      class="rounded-2xl overflow-hidden border border-border bg-accent-soft"
    >
      <img
        src={imgSrc}
        alt={projeto.titulo}
        class="w-full h-auto object-cover"
        loading="eager"
      />
    </div>

    <!-- Corpo: estudo de caso + sidebar -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-12">
      <!-- Conteúdo -->
      <div class="md:col-span-2 space-y-10">
        {
          projeto.detalhes?.problema && (
            <section class="space-y-3">
              <h2 class="font-display text-2xl text-text-strong">O desafio</h2>
              <p class="text-text-muted leading-relaxed whitespace-pre-line">
                {projeto.detalhes.problema}
              </p>
            </section>
          )
        }

        {
          projeto.detalhes?.solucao && (
            <section class="space-y-3">
              <h2 class="font-display text-2xl text-text-strong">A solução</h2>
              <p class="text-text-muted leading-relaxed whitespace-pre-line">
                {projeto.detalhes.solucao}
              </p>
            </section>
          )
        }

        {
          (projeto.detalhes?.funcionalidades?.length ?? 0) > 0 && (
            <section class="space-y-3">
              <h2 class="font-display text-2xl text-text-strong">
                Funcionalidades
              </h2>
              <ul class="space-y-2">
                {projeto.detalhes!.funcionalidades!.map((f) => (
                  <li class="flex items-start gap-3 text-text-muted">
                    <span class="text-accent mt-1" aria-hidden="true">
                      ▹
                    </span>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          projeto.detalhes?.aprendizados && (
            <section class="space-y-3">
              <h2 class="font-display text-2xl text-text-strong">
                Aprendizados
              </h2>
              <p class="text-text-muted leading-relaxed whitespace-pre-line">
                {projeto.detalhes.aprendizados}
              </p>
            </section>
          )
        }

        {
          !temDetalhes && (
            <p class="text-text-muted leading-relaxed">
              Este projeto ainda não tem um estudo de caso detalhado. Em breve,
              mais sobre o processo e as decisões técnicas por trás dele.
            </p>
          )
        }
      </div>

      <!-- Sidebar: stack -->
      <aside class="space-y-6">
        <div
          class="rounded-xl border border-border bg-surface p-6 space-y-4 md:sticky md:top-24"
        >
          <h2
            class="text-xs uppercase tracking-widest text-accent font-semibold"
          >
            Stack & ferramentas
          </h2>
          <div class="flex flex-wrap gap-2">
            {
              projeto.tecnologias.map((tec) => (
                <span class="text-xs px-2.5 py-1 rounded-full bg-surface-alt text-text-muted">
                  {tec}
                </span>
              ))
            }
          </div>

          {
            projeto.repoPrivado && (
              <p class="text-xs text-text-muted leading-relaxed pt-2 border-t border-border">
                O código-fonte é privado (contém dados sensíveis). Posso
                liberar acesso de leitura sob solicitação.
              </p>
            )
          }
        </div>
      </aside>
    </div>

    <!-- Galeria -->
    {
      galeria.length > 0 && (
        <section class="space-y-5">
          <h2 class="font-display text-2xl text-text-strong">Galeria</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {galeria.map((g, i) => (
              <div class="rounded-xl overflow-hidden border border-border bg-accent-soft">
                <img
                  src={g}
                  alt={`${projeto.titulo} — imagem ${i + 1}`}
                  class="w-full h-auto object-cover"
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        </section>
      )
    }
  </main>

  <Footer />
</Layout>
