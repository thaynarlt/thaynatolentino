---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import { caminhoEquivalente, codigoIdioma, idiomaDe, idiomas, localeOg } from "../i18n/idiomas";
import { useTextos } from "../i18n/ui";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const idioma = idiomaDe(Astro.currentLocale);
const t = useTextos(idioma);

const {
  title = t.meta.titulo,
  description = t.meta.descricao,
  image = "/og-image.png",
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://thaynarlt.com.br");
const ogImage = new URL(image, siteUrl).toString();
const canonical = new URL(Astro.url.pathname, siteUrl).toString();

// Mesma página nos dois idiomas, para o Google ligar uma à outra (hreflang).
// Páginas sem tradução (ex.: /design-system) não recebem os links.
const semBarraFinal = (p: string) => p.replace(/(.)\/$/, "$1");
const caminho = semBarraFinal(Astro.url.pathname);
const ida = caminhoEquivalente(caminho, idioma === "pt" ? "en" : "pt");
const temTraducao = semBarraFinal(caminhoEquivalente(ida, idioma)) === caminho;
const alternativas = temTraducao
  ? idiomas.map((i) => ({
      idioma: i,
      url: new URL(caminhoEquivalente(caminho, i), siteUrl).toString(),
    }))
  : [];
---

<!doctype html>
<html lang={codigoIdioma[idioma]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />

    <!-- Tema: o claro é o padrão; o escuro só entra se a pessoa escolheu no botão.
         Aplicado antes da pintura para não piscar o tema errado. -->
    <script is:inline>
      (() => {
        let tema = null;
        try {
          tema = localStorage.getItem("tema");
        } catch {}
        document.documentElement.dataset.theme = tema === "dark" ? "dark" : "light";
      })();
    </script>
    <meta name="theme-color" content="#FAFAF7" />

    <!-- SEO básico -->
    <link rel="canonical" href={canonical} />
    {
      alternativas.map((a) => (
        <link rel="alternate" hreflang={codigoIdioma[a.idioma]} href={a.url} />
      ))
    }
    {
      alternativas.length > 0 && (
        <link rel="alternate" hreflang="x-default" href={alternativas[0].url} />
      )
    }
    <meta name="author" content="Thayná Tolentino" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph (Facebook, LinkedIn, WhatsApp) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={localeOg[idioma]} />
    <meta property="og:locale:alternate" content={localeOg[idioma === "pt" ? "en" : "pt"]} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <!-- Extras por página (ex.: dados estruturados da home) -->
    <slot name="head" />
    <script>
      const reveal = (el: Element) => {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -60px 0px" },
        );
        observer.observe(el);
      };

      document.querySelectorAll("[data-reveal]").forEach(reveal);
    </script></head
  >

  <body>
    <slot />
    <!-- Vercel Web Analytics: sem cookies; precisa estar ativado no painel da Vercel -->
    <Analytics />
  </body>
</html>
