---
const year = new Date().getFullYear();

const quickLinks = [
  { label: "Projetos", href: "#projetos" },
  { label: "Experiência", href: "#experiencia" },
  { label: "Sobre", href: "#sobre" },
  { label: "Contato", href: "#contato" },
];
---

<footer class="border-t border-border py-10">
  <div
    class="mx-auto max-w-6xl px-6 flex flex-col md:flex-row md:items-center md:justify-between gap-6"
  >
    <div class="space-y-1">
      <p class="font-display text-xl text-text-strong">
        Thayná<span class="text-accent">.</span>
      </p>
      <p class="text-sm text-text-muted">
        © {year} · Feito com
        <a
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer"
          class="text-text hover:text-accent transition-colors"
        >
          Astro
        </a>
      </p>
    </div>

    <nav class="flex flex-wrap gap-6 text-sm">
      {
        quickLinks.map((link) => (
          <a
            href={link.href}
            class="text-text-muted hover:text-accent transition-colors"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
