---
import { NICHOS, type Nicho } from "../../types";
import { projetosEm } from "../../i18n/conteudo";
import { idiomaDe, urls } from "../../i18n/idiomas";
import { termo } from "../../i18n/termos";
import { useTextos } from "../../i18n/ui";
import FilteredProjects from "../react/FilteredProjects";
import { comCapasOtimizadas } from "../../utils/imagens";

const idioma = idiomaDe(Astro.currentLocale);
const t = useTextos(idioma);

// Projetos de programação têm seção própria (Desenvolvimento), em destaque
// logo após o Hero — aqui fica o portfólio criativo (design, UI/UX, vídeo).
const projetosCriativos = await comCapasOtimizadas(
  projetosEm(idioma).filter((p) => p.nicho !== "Desenvolvimento"),
);
const rotulosNicho = Object.fromEntries(NICHOS.map((n) => [n, termo(n, idioma)])) as Record<Nicho, string>;
---

<section id="projetos" class="py-20 md:py-28 border-t border-border">
  <div class="mx-auto max-w-7xl px-6 space-y-14">
    <!-- Cabeçalho da seção -->
    <!-- Header em 2 colunas -->
    <header class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-end">
      <div class="md:col-span-7 space-y-4">
        <p
          data-reveal
          class="text-sm uppercase tracking-widest text-accent font-semibold"
        >
          {t.projetos.eyebrow}
        </p>
        <h2
          data-reveal
          style="--reveal-delay: 80ms"
          class="font-display text-6xl md:text-8xl text-text-strong leading-[0.95]"
        >
          {t.projetos.titulo1}<br />
          {t.projetos.titulo2}<br />
          <span class="italic text-accent">{t.projetos.tituloDestaque}</span>.
        </h2>
      </div>

      <div class="md:col-span-5 space-y-3">
        <p
          data-reveal
          style="--reveal-delay: 160ms"
          class="text-lg text-text-muted leading-relaxed"
        >
          {t.projetos.texto}
        </p>
      </div>
    </header>

    <FilteredProjects
      projetos={projetosCriativos}
      textos={{ destaques: t.projetos.destaques, todos: t.projetos.todos, vazio: t.projetos.vazio }}
      rotulosNicho={rotulosNicho}
      baseEstudoDeCaso={urls.projeto(idioma, "")}
      client:visible
    />
  </div>
</section>
