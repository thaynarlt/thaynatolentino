---
import { projetos } from "../../data/projetos";
import FilteredProjects from "../react/FilteredProjects";
---

<section id="projetos" class="py-20 md:py-28 border-t border-border">
  <div class="mx-auto max-w-6xl px-6 space-y-12">
    <!-- Cabeçalho da seção -->
    <header class="space-y-4">
      <p
        data-reveal
        class="text-sm uppercase tracking-widest text-accent font-semibold"
      >
        Projetos
      </p>
      <h2
        data-reveal
        style="--reveal-delay: 80ms"
        class="font-display text-5xl md:text-6xl text-text-strong leading-tight max-w-3xl"
      >
        Um pouco de tudo que já construí.
      </h2>
      <p
        data-reveal
        style="--reveal-delay: 160ms"
        class="text-lg text-text-muted max-w-2xl"
      >
        UI/UX, front-end, design gráfico, edição de vídeo. Cada projeto conversa
        entre si.
      </p>
    </header>

    <FilteredProjects projetos={projetos} client:visible />
  </div>
</section>
