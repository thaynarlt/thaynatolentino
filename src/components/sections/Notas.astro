---
import NotaCard from "../ui/NotaCard.astro";
import { notasPorIdioma } from "../../utils/notas";

// Na home, só as três mais recentes; a lista completa fica em /notas.
const recentes = (await notasPorIdioma("pt")).slice(0, 3);
---

<section id="notas" class="py-20 md:py-28 border-t border-border">
  <div class="mx-auto max-w-6xl px-6 space-y-12">
    <header class="flex flex-wrap items-end justify-between gap-6">
      <div class="space-y-4">
        <p data-reveal class="text-sm uppercase tracking-widest text-accent font-semibold">
          Notas
        </p>
        <h2
          data-reveal
          style="--reveal-delay: 80ms"
          class="font-display text-5xl md:text-6xl text-text-strong leading-tight"
        >
          Ideias e bastidores.
        </h2>
      </div>
      <a
        data-reveal
        style="--reveal-delay: 160ms"
        href="/notas"
        class="inline-flex items-center gap-1.5 text-accent font-medium hover:gap-2.5 transition-all"
      >
        Ver todas as notas
        <span aria-hidden="true">→</span>
      </a>
    </header>

    <ul class="grid gap-6 md:grid-cols-3">
      {
        recentes.map((nota, i) => (
          <li data-reveal style={`--reveal-delay: ${i * 100}ms`}>
            <NotaCard nota={nota} />
          </li>
        ))
      }
    </ul>
  </div>
</section>
