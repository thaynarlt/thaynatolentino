---
import { projetosEm } from "../../i18n/conteudo";
import { idiomaDe, urls } from "../../i18n/idiomas";
import { useTextos } from "../../i18n/ui";
import LiveShowcase from "../react/LiveShowcase";
import { comCapasOtimizadas } from "../../utils/imagens";

const idioma = idiomaDe(Astro.currentLocale);
const t = useTextos(idioma);

// Só os projetos de programação — o foco desta seção.
const devProjetos = await comCapasOtimizadas(
  projetosEm(idioma).filter((p) => p.nicho === "Desenvolvimento"),
  1600,
);
---

<section id="desenvolvimento" class="py-20 md:py-28 border-t border-border">
  <div class="mx-auto max-w-7xl px-6 space-y-14">
    <!-- Cabeçalho -->
    <header class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-end">
      <div class="md:col-span-7 space-y-4">
        <p
          data-reveal
          class="text-sm uppercase tracking-widest text-accent font-semibold"
        >
          {t.desenvolvimento.eyebrow}
        </p>
        <h2
          data-reveal
          style="--reveal-delay: 80ms"
          class="font-display text-6xl md:text-8xl text-text-strong leading-[0.95]"
        >
          {t.desenvolvimento.titulo1}<br />
          {t.desenvolvimento.titulo2}{" "}
          <span class="italic text-accent">{t.desenvolvimento.tituloDestaque}</span>.
        </h2>
      </div>

      <div class="md:col-span-5 space-y-3">
        <p
          data-reveal
          style="--reveal-delay: 160ms"
          class="text-lg text-text-muted leading-relaxed"
        >
          {t.desenvolvimento.texto1}{" "}
          <span class="text-text-strong font-medium">{t.desenvolvimento.textoDestaque}</span>{" "}
          {t.desenvolvimento.texto2}
        </p>
      </div>
    </header>

    <!-- Vitrine interativa (embed ao vivo / vídeo) -->
    <div data-reveal style="--reveal-delay: 240ms">
      <LiveShowcase
        projetos={devProjetos}
        textos={t.vitrine}
        baseEstudoDeCaso={urls.projeto(idioma, "")}
        client:visible
      />
    </div>
  </div>
</section>
