---
// Página inicial, usada por / e /en (o idioma vem da URL via Astro.currentLocale).
import Layout from "../../layouts/Layout.astro";
import Header from "../layout/Header.astro";
import Footer from "../layout/Footer.astro";
import Hero from "../sections/Hero.astro";
import FaixaEmpresas from "../sections/FaixaEmpresas.astro";
import Desenvolvimento from "../sections/Desenvolvimento.astro";
import Projetos from "../sections/Projetos.astro";
import Experiencia from "../sections/Experiencia.astro";
import Formacao from "../sections/Formacao.astro";
import Sobre from "../sections/Sobre.astro";
import Notas from "../sections/Notas.astro";
import Contato from "../sections/Contato.astro";
---

<Layout>
  <Header />
  <main>
    <Hero />
    <FaixaEmpresas />
    <Desenvolvimento />
    <Projetos />
    <Experiencia />
    <Formacao />
    <Sobre />
    <Notas />
    <Contato />
  </main>
  <Footer />
</Layout>
