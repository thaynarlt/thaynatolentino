---
/** Botão que alterna entre tema claro e escuro e lembra a escolha. */
import { idiomaDe } from "../../i18n/idiomas";
import { useTextos } from "../../i18n/ui";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
const t = useTextos(idiomaDe(Astro.currentLocale));
---

<button
  type="button"
  data-alternar-tema
  data-rotulo-escuro={t.nav.temaEscuro}
  data-rotulo-claro={t.nav.temaClaro}
  aria-label={t.nav.temaEscuro}
  class={`inline-flex items-center justify-center w-10 h-10 rounded-md text-text-muted hover:text-text transition-colors ${className}`}
>
  <!-- Lua: aparece no tema claro -->
  <svg
    class="dark:hidden"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
  <!-- Sol: aparece no tema escuro -->
  <svg
    class="hidden dark:block"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
  </svg>
</button>

<script>
  const raiz = document.documentElement;
  const botoes = document.querySelectorAll<HTMLButtonElement>("[data-alternar-tema]");

  function atualizarRotulos() {
    const escuro = raiz.dataset.theme === "dark";
    botoes.forEach((b) => {
      b.setAttribute("aria-label", (escuro ? b.dataset.rotuloClaro : b.dataset.rotuloEscuro) ?? "");
    });
  }

  // O claro é o padrão (ver Layout.astro); a escolha fica salva neste navegador.
  function aplicar(tema: "light" | "dark") {
    raiz.dataset.theme = tema;
    try {
      localStorage.setItem("tema", tema);
    } catch {}
    atualizarRotulos();
  }

  botoes.forEach((b) =>
    b.addEventListener("click", () => aplicar(raiz.dataset.theme === "dark" ? "light" : "dark")),
  );

  atualizarRotulos();
</script>
