---
import { formatarData, slugDaNota, type Nota } from "../../utils/notas";

interface Props {
  nota: Nota;
}

const { nota } = Astro.props;
const { titulo, resumo, data, tags } = nota.data;
---

<a
  href={`/notas/${slugDaNota(nota)}`}
  class="group flex h-full flex-col gap-3 rounded-xl border border-border bg-surface p-6 hover:border-accent hover:shadow-accent transition-[border-color,box-shadow] duration-300"
>
  <time datetime={data.toISOString()} class="text-xs text-text-muted font-mono">
    {formatarData(data, "pt")}
  </time>
  <h3 class="font-display text-2xl text-text-strong leading-tight">{titulo}</h3>
  <p class="text-sm text-text-muted leading-relaxed flex-1">{resumo}</p>
  {
    tags.length > 0 && (
      <ul class="flex flex-wrap gap-1.5">
        {tags.map((t) => (
          <li class="text-xs px-2.5 py-1 rounded-full bg-surface-alt text-text-muted">{t}</li>
        ))}
      </ul>
    )
  }
  <span class="inline-flex items-center gap-1.5 text-sm font-medium text-accent group-hover:gap-2.5 transition-all">
    Ler nota
    <span aria-hidden="true">→</span>
  </span>
</a>
